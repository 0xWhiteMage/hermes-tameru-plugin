From 91f00e00e2307c5c96b2f3e129b04e0ac786d1d3 Mon Sep 17 00:00:00 2001
From: Benjamin Ang <hello@benjaminang.tv>
Date: Mon, 12 Oct 2026 02:05:03 +0800
Subject: [PATCH 8/8] fix(secrets): flag whole-line env/YAML credential
 assignments with identifier-like values (R3)

The red-team code exclusions also let unquoted snake_case passphrases and
dotted passwords through. A line that is only an env/shell assignment
(KEY=value, no spaces around =) or a YAML key: value line is flagged again,
unless the value is an expression/placeholder, ends in , ; ) (a keyword
argument on its own line) or, for YAML, is an attribute chain (annotation).
Hermes probe (2,372 non-test .py files): 15 hits before and after; linear.
---
 src/tameru/compress_context.py   | 14 ++++++++++++++
 tests/test_secrets_screen_141.py | 33 ++++++++++++++++++++++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/src/tameru/compress_context.py b/src/tameru/compress_context.py
index 8dfcf15..11a7518 100644
--- a/src/tameru/compress_context.py
+++ b/src/tameru/compress_context.py
@@ -106,6 +106,20 @@ _SECRETS_RE = re.compile(
     r"(?![^\s\"']*[(\[{<$])(?!(?:[A-Za-z_]\w*\.)+[A-Za-z_]\w*(?![^\s,;)\]}]))"
     r"(?![a-z_](?=[a-z0-9_]*_)[a-z0-9_]*(?![^\s,;)\]}]))"
     r"[^\s\"']{16,})"
+    # 1.4.1 fix-all: the code exclusions above also let through unquoted
+    # snake_case passphrases and dotted passwords. A whole-line ``.env`` /
+    # shell assignment (``DB_PASSWORD=correct_horse_battery_staple``, no
+    # spaces around ``=``) or a YAML ``key: value`` line still names one: the
+    # value runs to the end of the line and does not end in ``,`` ``;`` ``)``
+    # (a keyword argument on its own line). YAML keeps the attribute-chain
+    # exclusion (``api_key: pydantic.types.SecretStr`` is an annotation).
+    r"|(?im:^[ \t]*(?:export[ \t]+)?(?:[A-Za-z0-9_]+_)?"
+    r"(?:password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)"
+    r"=(?![^\s\"']*[(\[{<$])[^\s\"']{15,}[^\s\"',;)][ \t]*$)"
+    r"|(?im:^[ \t]*(?:[A-Za-z0-9_]+_)?"
+    r"(?:password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)"
+    r":[ \t]+(?![^\s\"']*[(\[{<$])(?!(?:[A-Za-z_]\w*\.)+[A-Za-z_]\w*[ \t]*$)"
+    r"[^\s\"']{15,}[^\s\"',;)][ \t]*$)"
 )
 
 # Recursion guard markers: output Tameru itself produced.
diff --git a/tests/test_secrets_screen_141.py b/tests/test_secrets_screen_141.py
index 7728d04..29d3e3a 100644
--- a/tests/test_secrets_screen_141.py
+++ b/tests/test_secrets_screen_141.py
@@ -71,3 +71,36 @@ def test_the_code_exclusions_stay_linear():
         started = time.perf_counter()
         contains_secret(text)
         assert time.perf_counter() - started < 2.0
+
+
+# ---- 1.4.1 fix-all (R3): whole-line env / YAML assignments -------------------------------------------------
+def test_env_and_yaml_lines_with_identifier_like_values_match():
+    assert contains_secret("DB_PASSWORD=correct_horse_battery_staple")
+    assert contains_secret("export API_KEY=prod_key_for_billing_v2\n")
+    assert contains_secret("HOST=db\npassword=hunter2.example.org.pass\nPORT=5432")
+    assert contains_secret("AUTH_TOKEN=team.alpha.deploy.token.x")
+    assert contains_secret("db:\n  secret: correct_horse_battery_staple\n")
+
+
+def test_code_lines_with_identifier_values_still_do_not_match():
+    for text in (
+        "password = settings_default_password",
+        "conn = connect(password=db_password_setting)",
+        "    user_password=args.user_password,",
+        "            app_secret=self._app_secret,",
+        "api_key: pydantic.types.SecretStr",
+        "PASSWORD=${DB_PASSWORD_FROM_VAULT}",
+        "secret = self.config.secret_value_x",
+        "  access_token: Optional[str] = None",
+        "x = 1; password=fallback_password_value",   # not a whole line
+    ):
+        assert not contains_secret(text), text
+
+
+def test_the_line_anchored_assignments_stay_linear():
+    import time
+
+    for text in ("db_" * 200_000 + "password=" + "a_" * 1000 + ",", ("secret_" * 2000 + "x\n") * 50, "API_KEY=" + "a_" * 300_000 + ")"):
+        started = time.perf_counter()
+        contains_secret(text)
+        assert time.perf_counter() - started < 2.0
