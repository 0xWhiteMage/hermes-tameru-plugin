From a1e8a7f0e966996f5964ce99714d472b1b28259e Mon Sep 17 00:00:00 2001
From: Benjamin Ang <hello@benjaminang.tv>
Date: Mon, 12 Oct 2026 01:18:34 +0800
Subject: [PATCH] fix(secrets): unquoted-assignment pattern no longer flags
 code expressions (red-team)

173a948 added an unquoted KEY=value secrets pattern ([^\s"']{16,}). It matched
ordinary code: contains_secret() was true for 141 of 2,372 non-test .py files
of a Hermes checkout (9 at a541e92), and the Hermes plugin's recovery store
refuses originals that contain a secret, so tameru_expand could not serve
those files from the store.

A value that is a call, index, ${...}/<...> placeholder, attribute chain or
lower-case snake_case name is excluded (15/2,372 files now, all literal
fixture keys). Lookaheads are linear (test pins 200K-char inputs < 2 s).
Only the CCR store uses the screen inside the engine, so compressed output
is unchanged.

Tests: tests/test_secrets_screen_141.py (fails before this change).
---
 CHANGELOG.md                     |  1 +
 src/tameru/compress_context.py   |  8 +++++++-
 tests/test_secrets_screen_141.py | 35 ++++++++++++++++++++++++++++++++
 3 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 3e16536..cff3186 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -27,6 +27,7 @@ byte-identical to 1.4.0: `run_battery` 15/15 and `threshold_sweep`
 ### Fixed
 - Command-line options in the query (`-n`, `--stat`, copied with the command, as the Hermes plugin does) are no longer adapter selectors. As "strong" selectors they crowded out the searched name: `rg -n Name` matched by `-n` alone selected nothing, so the saturated-query mode never ran and the plugin still fell to its brief and lost the definition line.
 - A captured section ends at the next rule, test-block header or pytest section header, not at the first blank line: captured stdout with blank lines collapsed only up to its first blank line.
+- Red-team round: the unquoted `KEY=value` secrets pattern flagged ordinary code (`password = get_password_from_vault()`, `api_key = agent._anthropic_api_key`, `api_key=fallback_api_key,`). On a Hermes checkout `contains_secret` was true for 141 of 2,372 non-test Python files (9 before 1.4.1), so a host that refuses to keep secret-bearing originals (the Hermes plugin's recovery store) dropped them. A value that is a call, an index, a `${...}`/`<...>` placeholder, an attribute chain or a lower-case snake_case name is no longer a match: 15 of 2,372 files now, all literal fixture keys. The exclusions are linear (a test pins 200K-char inputs under 2 s).
 - `test_deep_malformed_cache_record_does_not_raise` failed on Python 3.12+ (a 1000-deep list now parses and is removed as a non-record; older versions raised RecursionError and kept it). The test now accepts either outcome and still requires no exception and no retrieval; `sweep_ccr_cache`'s docstring now says that parseable non-records are removed (that was already the behaviour other tests pin).
 
 ## [1.4.0] - 2026-10-06
diff --git a/src/tameru/compress_context.py b/src/tameru/compress_context.py
index d2140bb..c65b0a6 100644
--- a/src/tameru/compress_context.py
+++ b/src/tameru/compress_context.py
@@ -99,7 +99,13 @@ _SECRETS_RE = re.compile(
     r"|\b(?:sk|rk)_live_[A-Za-z0-9]{16,}"
     r"|(?i:\b(?:authorization\s*:\s*)?bearer\s+[A-Za-z0-9._~+/=-]{20,})"
     r"|(?i:\b(?:[A-Za-z0-9_]+_)?(?:password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)\b"
-    r"\s*[:=]\s*[^\s\"']{16,})"
+    r"\s*[:=]\s*"
+    # 1.4.1 red-team: an unquoted value that is code (a call, an index, a
+    # ``${...}`` / ``<...>`` placeholder, an attribute chain, a snake_case
+    # variable such as ``api_key=fallback_api_key,``) names no credential.
+    r"(?![^\s\"']*[(\[{<$])(?!(?:[A-Za-z_]\w*\.)+[A-Za-z_]\w*(?![^\s,;)\]}]))"
+    r"(?![a-z_](?=[a-z0-9_]*_)[a-z0-9_]*(?![^\s,;)\]}]))"
+    r"[^\s\"']{16,})"
 )
 
 # Recursion guard markers: output Tameru itself produced.
diff --git a/tests/test_secrets_screen_141.py b/tests/test_secrets_screen_141.py
index a1425e8..7728d04 100644
--- a/tests/test_secrets_screen_141.py
+++ b/tests/test_secrets_screen_141.py
@@ -36,3 +36,38 @@ def test_negative_prose_does_not_match():
         "token=abc",
     ):
         assert not contains_secret(text)
+
+
+def test_code_expressions_are_not_unquoted_secrets():
+    """Red-team (1.4.1): the unquoted-assignment pattern flagged ordinary code, so ``contains_secret`` was true for
+    141 of 2,372 non-test Python files of a Hermes checkout (9 before 1.4.1), and the plugin's recovery store
+    refused to keep those originals. A value that is a call, an index, an attribute chain or an interpolation
+    names no credential."""
+    for text in (
+        "password = get_password_from_vault()",
+        "api_key = os.getenv(self.config.api_key_env)",
+        "api_key = agent._anthropic_api_key",
+        "explicit_api_key=binding.explicit_api_key,",
+        "otp_secret = normalize_otp_secret(str(secret.get('x')))",
+        "db_password: ${DB_PASSWORD_FROM_ENV}",
+        "auth_token=<redacted-by-server>",
+        "access_token = token_response['access_token']",
+        "explicit_api_key=_fb_explicit_key,",
+        "stale_access_token=stale_access_token)",
+    ):
+        assert not contains_secret(text), text
+
+
+def test_unquoted_credentials_with_punctuation_still_match():
+    assert contains_secret("password=p@ss!word#2024xyz")
+    assert contains_secret("DB_PASSWORD=Xk9-2mQ_vL8+pR4/zT6=")
+    assert contains_secret("api_key: abcdef0123456789abcdef")
+
+
+def test_the_code_exclusions_stay_linear():
+    import time
+
+    for text in ("api_key=a" + "_a" * 200_000 + "!", "api_key=" + "ab." * 200_000 + "a!", "api_key=x_y " * 50_000):
+        started = time.perf_counter()
+        contains_secret(text)
+        assert time.perf_counter() - started < 2.0
