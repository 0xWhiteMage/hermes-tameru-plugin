+        if len(picked) >= limit:
+            return False
+        fp = _error_fp(lines[i])
+        if fp in seen_tpl or i in picked:
+            return True
+        seen_tpl.add(fp)
+        picked.add(i)
+        return True
+
+    for i, line in enumerate(lines):
+        if line.strip() and _is_error_line(line):
+            if not take(i):
+                break
