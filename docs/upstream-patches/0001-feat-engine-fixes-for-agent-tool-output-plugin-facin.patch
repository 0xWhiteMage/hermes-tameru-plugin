diff --git a/tests/test_sync_check.py b/tests/test_sync_check.py
new file mode 100644
index 0000000..e7acfa1
--- /dev/null
+++ b/tests/test_sync_check.py
@@ -0,0 +1,165 @@
+"""`scripts/sync_to_harness.py --check`: read-only drift detection."""
+from __future__ import annotations
+
+import contextlib
+import importlib.util
+import io
+import re
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "scripts" / "sync_to_harness.py"
+SRC = ROOT / "src" / "tameru"
+
+_spec = importlib.util.spec_from_file_location("sync_to_harness", SCRIPT)
+sync = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(sync)
+
+
+def _run(*argv: str) -> tuple[int, str, str]:
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        code = sync.main(list(argv))
+    return code, out.getvalue(), err.getvalue()
+
+
+def _snapshot(root: Path) -> dict[str, bytes]:
+    return {
+        str(p.relative_to(root)): p.read_bytes()
+        for p in sorted(root.rglob("*"))
+        if p.is_file()
+    }
+
+
+class SyncCheckTests(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        # Layout mirrors the plugin repo: <plugin>/plugin.yaml + <plugin>/tameru/
+        self.plugin = Path(self._tmp.name) / "plugin"
+        self.target = self.plugin / "tameru"
+        self.target.mkdir(parents=True)
+        (self.target / "__init__.py").write_text("# harness-owned glue\n", encoding="utf-8")
+        self.manifest = self.plugin / "plugin.yaml"
+        self.manifest.write_text(
+            "name: tameru\nversion: 0.0.1\ndescription: Tameru 0.0.1 context engine\n",
+            encoding="utf-8",
+        )
+        # Vendor for real (the normal, writing mode), including the manifest stamp.
+        code, _out, _err = _run(str(self.target), "--manifest", "../plugin.yaml")
+        self.assertEqual(code, 0)
+
+    def _check(self, *extra: str) -> tuple[int, str]:
+        code, out, _err = _run(str(self.target), "--manifest", "../plugin.yaml", "--check", *extra)
+        return code, out
+
+    def test_clean_vendored_copy_passes(self):
+        code, out = self._check()
+        self.assertEqual(code, 0, out)
+        self.assertIn("in sync", out)
+
+    def test_mutated_module_fails_and_is_named(self):
+        victim = min(p for p in self.target.glob("*.py") if p.name != "__init__.py")
+        victim.write_text(victim.read_text(encoding="utf-8") + "\n# local edit\n", encoding="utf-8")
+        code, out = self._check()
+        self.assertEqual(code, 1)
+        self.assertRegex(out, rf"differs:\s+{re.escape(victim.name)}")
+
+    def test_crlf_only_difference_is_not_drift(self):
+        victim = min(p for p in self.target.glob("*.py") if p.name != "__init__.py")
+        victim.write_bytes(victim.read_bytes().replace(b"\n", b"\r\n"))
+        self.assertEqual(self._check()[0], 0)
+
+    def test_missing_upstream_module_fails(self):
+        victim = min(p for p in self.target.glob("*.py") if p.name != "__init__.py")
+        victim.unlink()
+        code, out = self._check()
+        self.assertEqual(code, 1)
+        self.assertRegex(out, rf"missing:\s+{re.escape(victim.name)}")
+
+    def test_stale_vendored_module_fails(self):
+        (self.target / "removed_upstream.py").write_text("x = 1\n", encoding="utf-8")
+        code, out = self._check()
+        self.assertEqual(code, 1)
+        self.assertRegex(out, r"stale:\s+removed_upstream\.py")
+
+    def test_stale_manifest_version_fails(self):
+        self.manifest.write_text(
+            self.manifest.read_text(encoding="utf-8").replace(
+                f"version: {sync._upstream_version()}", "version: 0.0.1"
+            ),
+            encoding="utf-8",
+        )
+        code, out = self._check()
+        self.assertEqual(code, 1)
+        self.assertIn("plugin.yaml", out)
+        self.assertIn(sync._upstream_version(), out)
+
+    def test_manifest_is_resolved_relative_to_target(self):
+        # "plugin.yaml" would be <target>/plugin.yaml, which does not exist: that
+        # must be reported, not silently treated as "nothing to stamp".
+        code, out, _err = _run(str(self.target), "--manifest", "plugin.yaml", "--check")
+        self.assertEqual(code, 1)
+        self.assertIn("not found", out)
+        self.assertIn("relative to the target", out)
+
+    def test_check_never_writes(self):
+        # Make the target drift in every way at once, then check.
+        mods = sorted(p for p in self.target.glob("*.py") if p.name != "__init__.py")
+        mods[0].write_text("# changed\n", encoding="utf-8")
+        mods[1].unlink()
+        (self.target / "removed_upstream.py").write_text("x = 1\n", encoding="utf-8")
+        self.manifest.write_text("name: tameru\nversion: 0.0.1\n", encoding="utf-8")
+        before = _snapshot(self.plugin)
+        code, _out = self._check()
+        self.assertEqual(code, 1)
+        self.assertEqual(_snapshot(self.plugin), before)
+
+    def test_sync_fixes_what_check_reported(self):
+        mods = sorted(p for p in self.target.glob("*.py") if p.name != "__init__.py")
+        mods[0].write_text("# changed\n", encoding="utf-8")
+        (self.target / "removed_upstream.py").write_text("x = 1\n", encoding="utf-8")
+        self.manifest.write_text("name: tameru\nversion: 0.0.1\n", encoding="utf-8")
+        self.assertEqual(self._check()[0], 1)
+        code, _out, _err = _run(str(self.target), "--manifest", "../plugin.yaml")
+        self.assertEqual(code, 0)
+        self.assertEqual(self._check()[0], 0)
+
+    def test_stamp_only_check_ignores_modules(self):
+        glue = Path(self._tmp.name) / "glue"
+        glue.mkdir()
+        (glue / "plugin.yaml").write_text("version: 0.0.1\n", encoding="utf-8")
+        args = (str(glue), "--manifest", "plugin.yaml", "--stamp-only", "--check")
+        self.assertEqual(_run(*args)[0], 1)  # stale stamp
+        self.assertEqual(_run(str(glue), "--manifest", "plugin.yaml", "--stamp-only")[0], 0)
+        self.assertEqual(_run(*args)[0], 0)  # no modules expected, none required
+
+    def test_missing_target_is_an_error_not_drift(self):
+        code, _out, err = _run(str(Path(self._tmp.name) / "nope"), "--check")
+        self.assertEqual(code, 2)
+        self.assertIn("does not exist", err)
+
+    def test_exit_status_via_subprocess(self):
+        cmd = [sys.executable, str(SCRIPT), str(self.target), "--manifest", "../plugin.yaml", "--check"]
+        ok = subprocess.run(cmd, capture_output=True, text=True)
+        self.assertEqual(ok.returncode, 0, ok.stdout + ok.stderr)
+        victim = min(p for p in self.target.glob("*.py") if p.name != "__init__.py")
+        victim.write_text("# drift\n", encoding="utf-8")
+        bad = subprocess.run(cmd, capture_output=True, text=True)
+        self.assertEqual(bad.returncode, 1)
+        self.assertIn(victim.name, bad.stdout)
+
+    def test_help_documents_check_and_manifest_resolution(self):
+        text = subprocess.run(
+            [sys.executable, str(SCRIPT), "--help"], capture_output=True, text=True
+        ).stdout
+        self.assertIn("--check", text)
+        self.assertRegex(text, r"relative\s+to\s+the\s+TARGET")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_task_query.py b/tests/test_task_query.py
new file mode 100644
index 0000000..29d79c9
--- /dev/null
+++ b/tests/test_task_query.py
@@ -0,0 +1,467 @@
+"""`tameru.transcript.text_of` and `task_query`: query parts for a tool result."""
+from __future__ import annotations
+
+import json
+import random
+import time
+import unittest
+from unittest import mock
+
+import pytest
+
+import tameru.transcript as transcript
+from tameru.transcript import (
+    apply_extractive_tool_prune,
+    last_user_text,
+    task_query,
+    text_of,
+)
+
+B64 = "QUJDREVGR0hJSktMTU5PUFFSU1RVVldYWVo=" * 12  # 444 chars, no whitespace
+
+
+def _call(call_id: str, name: str, args) -> dict:
+    return {"id": call_id, "type": "function", "function": {"name": name, "arguments": args}}
+
+
+def _session(args=None, followup_args=None) -> tuple[list[dict], int]:
+    """first user, assistant+call, tool result (idx 2), assistant follow-up, last user."""
+    args = {"path": "src/billing/invoice.py"} if args is None else args
+    followup_args = {"command": "pytest tests/test_invoice.py"} if followup_args is None else followup_args
+    messages = [
+        {"role": "user", "content": "FIRST-USER: migrate invoices to the new schema"},
+        {"role": "assistant", "content": "", "tool_calls": [_call("c1", "read_file", args)]},
+        {"role": "tool", "tool_call_id": "c1", "content": "x" * 5000},
+        {
+            "role": "assistant",
+            "content": "NEXT-ASSISTANT: the loader ignores tax_code",
+            "tool_calls": [_call("c2", "terminal", followup_args)],
+        },
+        {"role": "tool", "tool_call_id": "c2", "content": "ok"},
+        {"role": "user", "content": "LAST-USER: continue"},
+    ]
+    return messages, 2
+
+
+class TextOfTests(unittest.TestCase):
+    def test_str_is_returned_as_is(self):
+        self.assertEqual(text_of("  hello\nworld "), "  hello\nworld ")
+
+    def test_list_joins_text_parts_and_str_parts(self):
+        content = [
+            {"type": "text", "text": "one"},
+            {"type": "input_text", "text": "two"},
+            {"type": "output_text", "text": "three"},
+            "four",
+        ]
+        self.assertEqual(text_of(content), "one\ntwo\nthree\nfour")
+
+    def test_images_base64_and_unknown_parts_are_skipped(self):
+        content = [
+            {"type": "image_url", "image_url": {"url": "data:image/png;base64," + B64}},
+            {"type": "image", "source": {"type": "base64", "data": B64}, "text": "alt text"},
+            {"type": "tool_use", "id": "t", "input": {"q": "x"}},
+            {"type": "text", "text": "visible"},
+            {"type": "text"},
+            {"type": "text", "text": 5},
+            None,
+            7,
+        ]
+        self.assertEqual(text_of(content), "visible")
+
+    def test_dict_with_str_text(self):
+        self.assertEqual(text_of({"type": "text", "text": "hi"}), "hi")
+        self.assertEqual(text_of({"text": "bare"}), "bare")
+        self.assertEqual(text_of({"text": 3}), "")
+        self.assertEqual(text_of({"image": "x"}), "")
+
+    def test_everything_else_is_empty(self):
+        for value in (None, 0, 1.5, True, b"bytes", object(), (), set()):
+            with self.subTest(value=value):
+                self.assertEqual(text_of(value), "")
+        self.assertEqual(text_of([]), "")
+
+    def test_last_user_text_uses_text_of(self):
+        messages = [
+            {"role": "user", "content": "plain"},
+            {
+                "role": "user",
+                "content": [
+                    {"type": "image_url", "image_url": {"url": "data:image/png;base64," + B64}},
+                    {"type": "text", "text": "what is in this picture?"},
+                ],
+            },
+        ]
+        self.assertEqual(last_user_text(messages), "what is in this picture?")
+        self.assertEqual(last_user_text([{"role": "user", "content": None}]), "")
+
+
+class TaskQueryPriorityTests(unittest.TestCase):
+    def test_priority_order(self):
+        messages, idx = _session()
+        parts = task_query(messages, idx, focus="FOCUS: billing totals")
+        self.assertEqual(
+            parts,
+            [
+                "FOCUS: billing totals",
+                "read_file",
+                "src/billing/invoice.py",
+                "NEXT-ASSISTANT: the loader ignores tax_code",
+                "pytest tests/test_invoice.py",
+                "LAST-USER: continue",
+                "FIRST-USER: migrate invoices to the new schema",
+            ],
+        )
+
+    def test_no_focus_starts_at_the_tool_call(self):
+        messages, idx = _session()
+        parts = task_query(messages, idx)
+        self.assertEqual(parts[0], "read_file")
+        self.assertNotIn("FOCUS", " ".join(parts))
+
+    def test_dict_args_and_json_string_args_are_equivalent(self):
+        as_dict, idx = _session(args={"path": "a/b.py", "opts": {"pattern": "def run"}})
+        as_json, _ = _session(args=json.dumps({"path": "a/b.py", "opts": {"pattern": "def run"}}))
+        self.assertEqual(task_query(as_dict, idx), task_query(as_json, idx))
+        self.assertIn("a/b.py", task_query(as_dict, idx))
+        self.assertIn("def run", task_query(as_dict, idx))
+
+    def test_only_string_leaves_of_arguments_are_used(self):
+        messages, idx = _session(
+            args={"path": "x.py", "offset": 120, "limit": 50, "flags": [True, None, "-n"]}
+        )
+        parts = task_query(messages, idx)
+        self.assertIn("x.py", parts)
+        self.assertIn("-n", parts)
+        for number in ("120", "50", "True", "None"):
+            self.assertNotIn(number, parts)
+
+    def test_unparseable_string_args_become_one_part(self):
+        messages, idx = _session(args="grep -rn 'TODO' src/")
+        self.assertIn("grep -rn 'TODO' src/", task_query(messages, idx))
+
+    def test_flat_tool_call_shape(self):
+        messages, idx = _session()
+        messages[1]["tool_calls"] = [{"id": "c1", "name": "search_files", "arguments": {"q": "needle"}}]
+        parts = task_query(messages, idx)
+        self.assertEqual(parts[:2], ["search_files", "needle"])
+
+    def test_picks_the_call_that_produced_this_result(self):
+        messages = [
+            {"role": "user", "content": "go"},
+            {
+                "role": "assistant",
+                "content": "",
+                "tool_calls": [_call("a", "read_file", {"path": "A.py"}), _call("b", "read_file", {"path": "B.py"})],
+            },
+            {"role": "tool", "tool_call_id": "a", "content": "..."},
+            {"role": "tool", "tool_call_id": "b", "content": "..."},
+        ]
+        self.assertIn("B.py", task_query(messages, 3))
+        self.assertNotIn("A.py", task_query(messages, 3))
+        self.assertIn("A.py", task_query(messages, 2))
+
+    def test_result_without_a_call_still_gets_user_parts(self):
+        messages = [
+            {"role": "user", "content": "first"},
+            {"role": "tool", "tool_call_id": "ghost", "content": "..."},
+            {"role": "user", "content": "last"},
+        ]
+        self.assertEqual(task_query(messages, 1), ["last", "first"])
+        self.assertEqual(task_query(messages, 99), ["last", "first"])
+        self.assertEqual(task_query(messages, -1), ["last", "first"])
+        self.assertEqual(task_query([], 0), [])
+
+    def test_responses_style_ids_find_the_call(self):
+        """Hermes' Codex path: the tool message carries call_id (or ``call|item``), the call also has an id."""
+        for call_extra, answer in (
+            ({"id": "fc_1", "call_id": "call_1"}, "call_1"),
+            ({"id": "call_1|fc_1"}, "call_1"),
+            ({"id": "call_1|fc_1"}, "fc_1"),
+            ({"id": "fc_1"}, "call_1|fc_1"),
+            ({"call_id": "call_1"}, "call_1"),
+        ):
+            with self.subTest(call=call_extra, answer=answer):
+                messages, idx = _session(args={"path": "src/billing/invoice.py"})
+                messages[1]["tool_calls"] = [
+                    {**call_extra, "type": "function", "function": {"name": "read_file", "arguments": {"path": "A.py"}}}
+                ]
+                messages[idx]["tool_call_id"] = answer
+                parts = task_query(messages, idx)
+                self.assertEqual(parts[:2], ["read_file", "A.py"])
+
