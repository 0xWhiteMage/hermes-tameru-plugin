+    by_id = {b["id"]: b for b in scored}
+    assert by_id[4]["reason"] in {"critical lines", "log error"}
+    # A plain timestamped INFO line is not boosted as a "critical line".
+    assert by_id[2]["reason"] != "critical lines"
