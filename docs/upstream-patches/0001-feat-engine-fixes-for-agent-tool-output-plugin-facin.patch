+                len(_PATH_RE.findall(line))
+                + len(_EVID_FILE_RE.findall(line))
+                + len(_EVID_VERSION_RE.findall(line))
+                + len(_EVID_SHA_RE.findall(line))
+                + len(_EVID_KV_RE.findall(line))
+            )
+            if score >= 2:
