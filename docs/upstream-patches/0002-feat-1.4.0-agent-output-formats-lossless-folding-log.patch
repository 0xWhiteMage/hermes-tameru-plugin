+                "grep", lossless, total_matches, kept, "lossless regroup by file"
+            )
+    body, kept = render(False)
+    return AdapterResult(
+        "grep",
+        body,
+        total_matches,
+        kept,
+        "matches grouped by file, capped per file",
+        hit=any_hit[0] or matcher.empty,
+    )
